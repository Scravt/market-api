# Copiar a .env para correr con `npm run dev` (fuera de Docker).
JWT_SECRET=cambiar-por-un-secreto-largo
DATABASE_URL=postgres://market:market@127.0.0.1:5434/market
PORT=8080
SEED=true
# ACCESS_TTL_SECONDS=300
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=30
# PG_POOL_MAX=10
# Clave del laboratorio: Caddy (perfil tls) rechaza con 403 lo que no la mande en X-Lab-Key, y los
# escenarios de Crabfall la mandan siempre ({{env.LAB_KEY}}). En local no hace nada, pero hace falta.
LAB_KEY=cambiar-por-una-clave-larga
# SEED_PASSWORD=loadtest
# MAX_UPLOAD_MB=10
# REFRESH_TTL_SECONDS=604800
