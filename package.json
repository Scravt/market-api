{
  "name": "market-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "API real (Postgres, JWT, rate limiting, uploads) para probar lt fuera de la máquina local",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
